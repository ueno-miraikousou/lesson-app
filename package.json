{
  "name": "lesson-app",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:component": "jest --selectProjects component",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:watch": "jest --watch",
    "supabase:types": "supabase gen types typescript --local --schema public > src/types/database.generated.ts"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.6",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "8.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.16",
    "dotenv": "^16.4.5",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-haptics": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-sharing": "~13.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-tracking-transparency": "~5.1.1",
    "lucide-react-native": "^0.456.0",
    "nativewind": "^4.1.20",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-calendars": "^1.1310.0",
    "react-native-gesture-handler": "~2.20.0",
    "react-native-google-mobile-ads": "^14.7.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-qrcode-svg": "^6.3.12",
    "react-native-reanimated": "~3.16.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.14",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "msw": "^2.14.6",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.4.9",
    "typescript": "~5.6.3"
  },
