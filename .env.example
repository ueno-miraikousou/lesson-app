# 環境変数のテンプレート。
# このファイルをコピーして `.env` を作成し、実際の値を埋める。
# `.env` は git にコミットしないこと (`.gitignore` で除外済み)。

# ── Supabase (社長の Supabase アカウント作成後に取得) ──
# プロジェクト作成手順は 01_要件定義/社長手順_Supabase アカウント作成.md 参照
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# ── AdMob (フェーズ D の広告実装前に AdMob 管理画面で取得) ──
# テスト用 App ID は `app.config.ts` のフォールバック値で対応済みなので、本番値が出るまで未設定でも OK
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# ── Sentry (フェーズA末以降) ──
# Sentry プロジェクト作成後に取得
SENTRY_DSN=

# ── 環境フラグ ──
# development / preview / production のいずれか
APP_ENV=development

# ── EAS (EAS Build 設定後に自動入る) ──
# `eas init` 実行後に書き込まれる
EAS_PROJECT_ID=
