# 習い事管理アプリ — .gitignore
# 参照: 02_設計/mobile-engineer依頼書.md §5.2 (環境変数管理)

# ── 依存・ビルド ──
node_modules/
.expo/
dist/
web-build/
.next/

# ── 機密情報（絶対コミットしない） ──
.env
.env.local
.env.*.local
.env.production
.env.preview

# Supabase ローカル設定
.supabase/
supabase/.branches/
supabase/.temp/

# EAS / Expo
*.jks
*.p12
*.key
*.mobileprovision
*.orig.*
GoogleService-Info.plist
google-services.json

# ── ネイティブビルド成果物 ──
# expo prebuild 生成物。再現可能なので git 管理外。
# Windows 固有のローカル編集 (android.overridePathCheck=true 等) は
# 別途 docs に手順化予定。
android/
ios/


# ── エディタ・OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── ログ ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
npm-install.log
*.log
*.err

# ── 検証アーティファクト (一時) ──
screenshot-*.png
screenshots/
uihierarchy*.xml

# ── テスト・カバレッジ ──
coverage/
*.lcov
.nyc_output/

# ── TypeScript ──
*.tsbuildinfo

# ── Sentry ──
.sentryclirc

